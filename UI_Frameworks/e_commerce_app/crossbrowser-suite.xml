<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke-Suite" thread-count="3" parallel="tests">
  <listeners>
 	<listener class-name="utilities.ExtentReportManager"></listener>
 </listeners>
 
  <test name="Edge-Smoke-Tests">
  	<parameter name="browser" value="edge"></parameter>
  	<parameter name="os" value="windows"></parameter>
  	<groups>
  		<run>
  			<include name="smoke"></include>
  		</run>
  	</groups>
    <classes>
      <class name="testCases.CheckOutandPaymentTestCases"/>
      <class name="testCases.HomeCatalogueTestCases"/>
      <class name="testCases.UserRegistrationTestCases"/>
      <class name="testCases.UserLoginTestCases"/>
      <class name="testCases.CartTestCases"/>
    </classes>
  </test> <!-- Test -->
  
  <test name="Chrome-Smoke-Tests">
  	<parameter name="browser" value="chrome"></parameter>
  	<parameter name="os" value="windows"></parameter>
  	<groups>
  		<run>
  			<include name="smoke"></include>
  		</run>
  	</groups>
    <classes>
      <class name="testCases.CheckOutandPaymentTestCases"/>
      <class name="testCases.HomeCatalogueTestCases"/>
      <class name="testCases.UserRegistrationTestCases"/>
      <class name="testCases.UserLoginTestCases"/>
      <class name="testCases.CartTestCases"/>
    </classes>
  </test> <!-- Test -->
  
</suite> <!-- Suite -->
